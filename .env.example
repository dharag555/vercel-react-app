# ========================================================
# SVK — Inquiry Notification Service Configuration
# ========================================================

PORT=5000

# Where you want to receive customer inquiries
OWNER_EMAIL=svkdiamonds@gmail.com
OWNER_PHONE=+917718880577

# --------------------------------------------------------
# EMAIL CONFIGURATION (Gmail / SMTP)
# --------------------------------------------------------
# For Gmail:
# 1. Go to your Google Account -> Security -> 2-Step Verification
# 2. At the bottom, click "App passwords"
# 3. Create a password named "SVK Website" (16 letters)
# 4. Paste your email and the 16-letter app password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=svkdiamonds@gmail.com
SMTP_PASS=your_gmail_16_digit_app_password

# --------------------------------------------------------
# TWILIO CONFIGURATION (WhatsApp Notifications)
# --------------------------------------------------------
# Sign up at https://www.twilio.com (or log into console):
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Your Twilio WhatsApp Number (e.g., +14155238886 for Twilio Sandbox)
TWILIO_WHATSAPP_NUMBER=+14155238886
